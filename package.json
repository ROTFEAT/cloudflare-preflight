{
  "name": "cloudflare-cost-safety",
  "version": "1.0.1",
  "description": "Offline Cloudflare predeployment cost review skill and independent release gate",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22",
    "python": ">=3.10"
  },
  "bin": {
    "cf-cost-safety": ".agents/skills/cloudflare-cost-safety/scripts/cli.mjs"
  },
  "scripts": {
    "preflight": "node .agents/skills/cloudflare-cost-safety/scripts/cli.mjs preflight",
    "gate": "node .agents/skills/cloudflare-cost-safety/scripts/cli.mjs gate",
    "install-skill": "node scripts/install.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:runtime": "python3 scripts/sandbox.py --runtime --timeout 50 -- node node_modules/vitest/vitest.mjs run --configLoader native",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1",
    "node-sql-parser": "5.4.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
