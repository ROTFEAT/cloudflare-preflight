{
  "name": "fixture-cf-q-002",
  "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "main": "main.js",
  "compatibility_date": "2026-10-08",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "jobs"
      }
    ],
    "consumers": [
      {
        "queue": "jobs",
        "max_retries": 0
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "synthetic-database",
      "database_name": "fixture"
    }
  ]
}
