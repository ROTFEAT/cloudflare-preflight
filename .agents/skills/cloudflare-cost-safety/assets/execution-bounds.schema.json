{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudflare-cost-safety.local/schema/execution-bounds",
  "type": "object",
  "required": [
    "paths"
  ],
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path_id",
          "scope",
          "max_events",
          "work_limits",
          "reason",
          "enforcement",
          "observations"
        ],
        "properties": {
          "path_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "invocation",
              "logical_job",
              "time_window"
            ]
          },
          "max_events": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "window_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "work_limits": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "enforcement": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "start_line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "scenario",
                "case",
                "events",
                "work"
              ],
              "properties": {
                "scenario": {
                  "enum": [
                    "normal",
                    "no_progress",
                    "amplification",
                    "exhaustion",
                    "restart",
                    "replay",
                    "stop",
                    "time_boundary",
                    "partial_failure"
                  ]
                },
                "case": {
                  "type": "string",
                  "minLength": 1
                },
                "events": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "work": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "time_window"
                }
              }
            },
            "then": {
              "required": [
                "window_ms"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
