{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudflare-cost-safety.local/schema/approval",
  "type": "object",
  "required": [
    "schema_version",
    "input_digest",
    "finding_ids",
    "approver",
    "reason",
    "scope",
    "expires_at",
    "compensating_controls",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "compensating_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
