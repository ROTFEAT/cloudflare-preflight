{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudflare-cost-safety.local/schema/semantic-review",
  "type": "object",
  "required": [
    "schema_version",
    "input_digest",
    "reviewer",
    "model",
    "invocation",
    "reviewed_at",
    "rules",
    "official_skills",
    "tests",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "invocation": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "CF-DO-001",
              "CF-DO-002",
              "CF-DEP-001",
              "CF-SQL-001",
              "CF-SQL-002",
              "CF-JOB-001",
              "CF-Q-001",
              "CF-Q-002",
              "CF-KV-001",
              "CF-R2-001",
              "CF-HTTP-001",
              "CF-SAFE-001"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "finding",
              "not_applicable",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "start_line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "official_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "reviewed_files",
          "reason",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "reviewed",
              "unknown"
            ]
          },
          "reviewed_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "start_line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "input_digest",
          "command",
          "runner_digest",
          "duration_ms",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unsupported",
              "not_run"
            ]
          },
          "input_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "command": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "runner_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "metrics": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "runner_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule_id",
          "origin",
          "status",
          "severity",
          "confidence",
          "location",
          "summary",
          "execution_path",
          "usage_assessment",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "enum": [
              "official_best_practices",
              "cost_safety",
              "both"
            ]
          },
          "status": {
            "enum": [
              "BLOCK",
              "REVIEW",
              "ADVISORY"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "required": [
              "path",
              "start_line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "execution_path": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "usage_assessment": {
            "type": "object"
          },
          "native_control_limit": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "usage_assessment": {
      "type": "object",
      "required": [
        "classification",
        "scope",
        "vector",
        "assumptions",
        "enforced_limits",
        "evidence",
        "excluded",
        "usd_estimate"
      ],
      "properties": {
        "classification": {
          "enum": [
            "bounded_under_assumptions",
            "unknown",
            "unbounded_path"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "vector": {
          "type": "object",
          "required": [
            "events",
            "queue_deliveries",
            "new_messages",
            "sql_rows_read",
            "sql_rows_written",
            "kv_reads",
            "kv_writes",
            "kv_lists",
            "r2_class_a",
            "r2_class_b",
            "active_objects",
            "environments"
          ],
          "properties": {
            "events": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "queue_deliveries": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "new_messages": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "sql_rows_read": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "sql_rows_written": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "kv_reads": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "kv_writes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "kv_lists": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "r2_class_a": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "r2_class_b": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "active_objects": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "environments": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enforced_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "limit",
              "scope",
              "location"
            ],
            "properties": {
              "dimension": {
                "enum": [
                  "events",
                  "queue_deliveries",
                  "new_messages",
                  "sql_rows_read",
                  "sql_rows_written",
                  "kv_reads",
                  "kv_writes",
                  "kv_lists",
                  "r2_class_a",
                  "r2_class_b",
                  "active_objects",
                  "environments"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 0
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "object",
                "required": [
                  "path",
                  "start_line"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "start_line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "usd_estimate": {
          "const": null
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
