{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudflare-cost-safety.local/schema/trust",
  "type": "object",
  "required": [
    "schema_version",
    "keys",
    "official_skills_lock_digest",
    "policy_digest",
    "tool_digest",
    "max_age_hours"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "public_key",
          "roles",
          "origins"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "public_key": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "review",
                "approval"
              ]
            }
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "official_skills_lock_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tool_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "max_age_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    }
  },
  "additionalProperties": false
}
